  <property name="styleSheet">
   <string notr="true">QLabel#mac_current_lbl, QLabel#mac_alias_address_lbl {
    background-color: #e0e0e0; 
    color: #000000; 
    font-weight: bold; 
    padding: 4px; 
    border: 1px solid #b0b0b0; 
    border-radius: 3px;
}

QLabel#mac_alias_address_lbl[error=&quot;true&quot;] {
    background-color: #ffcccc; 
    color: #cc0000; 
    border: 1px solid #cc0000;
}

QTextEdit#ping_log_text {
    background-color: #1e1e1e; 
    color: #4af626; 
    font-family: &quot;Courier New&quot;, &quot;Liberation Mono&quot;, &quot;Monospace&quot;;
    font-size: 12px;
    border: 1px solid #333333; 
    border-radius: 4px; 
    padding: 5px; 
}

QTextEdit#ping_log_text QScrollBar:vertical {
    border: none;
    background: #2d2d2d;
    width: 10px;
    margin: 0px;
}
QTextEdit#ping_log_text QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 5px;
}
QTextEdit#ping_log_text QScrollBar::handle:vertical:hover {
    background: #4af626; 
}

QLineEdit[error=&quot;true&quot;] {
    border: 1px solid #cc0000;
    background-color: rgba(204, 0, 0, 0.15);
}
</string>
