  <property name="styleSheet">
   <string notr="true">QPushButton#ping_toggle_btn {
    background-color: #28a745;
    color: white;
    font-weight: bold;
    padding: 6px;
}
QPushButton#ping_toggle_btn:hover {
    background-color: #218838;
}

/* Динамические состояния кнопки (когда вешаем свойства из C++) */
QPushButton#ping_toggle_btn[state=&quot;active&quot;] {
    background-color: #dc3545;
}
QPushButton#ping_toggle_btn[state=&quot;active&quot;]:hover {
    background-color: #c82333;
}

QPushButton#ping_toggle_btn[state=&quot;stopping&quot;] {
    background-color: #636e72;
    color: #b2bec3;
}</string>
